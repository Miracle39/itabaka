*{box-sizing:border-box}
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#181b20;background:#f4f6f8}
body{margin:0;min-height:100vh;background:#f4f6f8}
button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.hidden{display:none!important}
.muted{color:#737a84}.full{width:100%}

.admin-header{height:78px;background:#fff;border-bottom:1px solid #e4e8ec;position:sticky;top:0;z-index:50}
.header-inner{max-width:1540px;height:100%;margin:0 auto;padding:0 30px;display:flex;align-items:center;gap:28px}
.brand-link{display:flex;flex-direction:column;flex:0 0 auto}.brand-link strong{font-size:14px;letter-spacing:.09em}.brand-link span{font-size:12px;color:#7a818a;margin-top:3px}
.main-nav{display:flex;gap:5px;margin-left:10px}
.nav-link{padding:11px 15px;border-radius:9px;font-size:14px;font-weight:850;color:#6e757e;white-space:nowrap}.nav-link:hover{background:#f0f2f4;color:#181b20}.nav-link.active{background:#181b20;color:#fff}
.header-actions{margin-left:auto;display:flex;align-items:center;gap:8px}.user-name{font-size:12px;color:#707780;margin-right:4px}

.admin-main{max-width:1540px;margin:0 auto;padding:34px 30px 80px}
.page-title-row{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
.page-title-row h1{font-size:42px;line-height:1.05;letter-spacing:-.04em;margin:5px 0 9px}.page-title-row p{font-size:15px;margin:0}.kicker{font-size:11px;font-weight:950;letter-spacing:.16em;color:#858c95}.page-count{font-size:14px;font-weight:850;background:#fff;border:1px solid #e0e4e8;border-radius:10px;padding:11px 14px}

.btn{border:0;border-radius:9px;min-height:43px;padding:10px 15px;font-size:14px;font-weight:850;display:inline-flex;align-items:center;justify-content:center;gap:8px}.btn.primary{background:#181b20;color:#fff}.btn.primary:hover{background:#2a2e35}.btn.ghost{background:#fff;color:#272c32;border:1px solid #dce1e6}.btn.ghost:hover{background:#f5f6f7}.btn.tiny{min-height:34px;font-size:12px;padding:7px 10px}.btn:disabled{opacity:.45;cursor:not-allowed}

.stats-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-bottom:24px}.stat-card{background:#fff;border:1px solid #e1e6ea;border-radius:15px;padding:18px 20px;min-height:112px;display:flex;flex-direction:column;justify-content:center;box-shadow:0 7px 22px rgba(25,35,50,.035)}.stat-card span{font-size:13px;color:#7c838d;font-weight:750}.stat-card strong{font-size:30px;line-height:1;margin-top:9px;letter-spacing:-.035em}

.panel-card{background:#fff;border:1px solid #e0e5e9;border-radius:16px;padding:26px;box-shadow:0 8px 26px rgba(25,35,50,.035)}.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:22px}.panel-head h2{font-size:24px;line-height:1.15;letter-spacing:-.025em;margin:4px 0 0}.panel-head p{font-size:14px;margin:6px 0 0}
.stack{display:flex;flex-direction:column;gap:15px}label{font-size:13px;font-weight:850;color:#252a31}input,select,textarea{width:100%;min-height:45px;margin-top:7px;border:1px solid #d9dfe4;border-radius:9px;background:#fff;color:#20242a;padding:11px 13px}textarea{min-height:106px;resize:vertical}input:focus,select:focus,textarea:focus{outline:0;border-color:#9ca5af;box-shadow:0 0 0 3px rgba(24,27,32,.06)}input[type=file]{padding:8px}input[type=color]{padding:4px;height:45px;cursor:pointer}
.form-grid{display:grid;gap:15px}.form-grid.two{grid-template-columns:1fr 1fr}.editor-actions{display:flex;gap:8px}
.products-page-grid{display:grid;grid-template-columns:460px minmax(0,1fr);gap:24px;align-items:start}.products-page-grid>.panel-card{min-width:0}
.compact-search{width:250px;min-height:43px;margin:0}.compact-search.wide{width:min(460px,100%)}

.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.catalog-card{border:1px solid #e4e8ec;border-radius:14px;overflow:hidden;background:#fff}.catalog-media{height:230px;background:#f1f3f5;display:grid;place-items:center;overflow:hidden}.catalog-media img{width:100%;height:100%;object-fit:cover}.no-image{font-size:11px;font-weight:900;color:#9ba2aa}.catalog-body{padding:17px}.catalog-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.product-code{font-size:11px;font-weight:900;letter-spacing:.09em;color:#858c94}.catalog-body h3{font-size:19px;margin:9px 0 7px}.catalog-desc{font-size:13px;line-height:1.5;color:#707780;min-height:39px;margin:0}.catalog-details{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.catalog-details div{background:#f7f8f9;border:1px solid #eceff1;border-radius:9px;padding:9px}.catalog-details span{display:block;color:#8a919a;font-size:9px;text-transform:uppercase;letter-spacing:.08em;font-weight:900}.catalog-details strong{display:block;margin-top:4px;font-size:12px}.status-pill{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:950;white-space:nowrap}.status-pill.active{background:#e3f5e8;color:#27723a}.status-pill.inactive{background:#edf0f2;color:#737a83}.status-pill.pending{background:#fff1bf;color:#795c00}.status-pill.paid{background:#dff4e6;color:#23753c}

.orders-panel{padding:24px}.orders-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.per-page{display:flex;align-items:center;gap:8px;white-space:nowrap;color:#777e87;font-size:13px}.per-page select{width:82px;margin:0}
.orders-table-wrap{overflow:auto;border:1px solid #e1e6ea;border-radius:12px}.orders-table{width:100%;min-width:1220px;border-collapse:collapse}.orders-table th{text-align:left;padding:13px 12px;background:#fafbfc;border-bottom:1px solid #e5e9ed;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#7c838c;white-space:nowrap}.orders-table td{padding:15px 12px;border-bottom:1px solid #eef1f3;vertical-align:top;font-size:13px}.orders-table tbody tr:hover{background:#fcfcfd}.orders-table td strong{display:block;font-size:13px}.orders-table td small{display:block;color:#7b828b;font-size:11px;line-height:1.45;margin-top:3px}.row-actions{display:flex;flex-wrap:wrap;gap:6px;align-items:center}.no-proof{font-size:10px;color:#979da5}.item-size{color:#777e86}.detail-box{padding:18px;background:#f8f9fa;border-top:1px solid #e8ebee}.detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.detail-grid>div{background:#fff;border:1px solid #e8ebee;border-radius:10px;padding:13px}.detail-grid span,.detail-products>span{display:block;font-size:10px;color:#858c95;text-transform:uppercase;letter-spacing:.08em;font-weight:900}.detail-grid strong{display:block;font-size:13px;margin-top:6px}.detail-grid small{display:block;font-size:11px;color:#737a83;margin-top:3px}.detail-products{margin-top:13px;background:#fff;border:1px solid #e8ebee;border-radius:10px;padding:13px}.detail-product-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #edf0f2;font-size:12px}.detail-product-row:last-child{border-bottom:0}
.pagination{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:16px}.pagination-buttons{display:flex;gap:5px}.page-btn{min-width:36px;height:36px;border:1px solid #dfe4e8;border-radius:8px;background:#fff;font-size:12px;font-weight:850}.page-btn.active{background:#181b20;border-color:#181b20;color:#fff}.page-btn:disabled{opacity:.4;cursor:not-allowed}

.size-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:20px}.size-card{background:#fff;border:1px solid #e1e6ea;border-radius:15px;padding:20px}.size-card-head{display:flex;align-items:baseline;gap:10px;border-bottom:1px solid #edf0f2;padding-bottom:12px;margin-bottom:10px}.size-card-head span{font-size:12px;letter-spacing:.1em;font-weight:950;color:#7c838b}.size-card-head strong{font-size:31px;letter-spacing:-.04em}.size-card-head small{font-size:11px;color:#858c94}.size-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.size-list>div{display:flex;justify-content:space-between;align-items:center;background:#f7f8f9;border:1px solid #eceff1;border-radius:9px;padding:10px 11px;font-size:13px}.size-list>div strong{font-size:15px}.size-list>.muted{font-size:12px}

.settings-layout{display:grid;grid-template-columns:1fr 1fr;gap:22px}.settings-layout>.panel-card{min-width:0}.settings-actions{grid-column:1/-1;display:flex;justify-content:flex-end}.settings-preview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.settings-preview>div{background:#fafbfc;border:1px solid #e5e9ec;border-radius:10px;padding:10px}.settings-preview span{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:#858c95}.settings-preview img{display:block;width:100%;height:130px;object-fit:contain;background:#fff;border-radius:7px;margin-top:7px}.settings-preview .banner-preview{object-fit:cover}

.admin-message{background:#fff;border:1px solid #e1e6ea;border-radius:10px;padding:12px 14px;margin-bottom:16px;font-size:13px}.admin-message.success{background:#eef9f1;border-color:#d0edd7;color:#266e3a}.admin-message.error{background:#fff0f0;border-color:#ffd1d1;color:#9b2929}.empty-state{padding:40px 20px;text-align:center;color:#8a9199;border:1px dashed #dbe1e5;border-radius:12px;background:#fafbfc}.loading{padding:30px;text-align:center;color:#777}

.admin-modal{position:fixed;inset:0;z-index:100}.modal-backdrop{position:absolute;inset:0;background:rgba(16,20,25,.62)}.modal-card{position:relative;width:min(920px,94vw);max-height:90vh;overflow:auto;margin:5vh auto;background:#fff;border-radius:16px;padding:24px;box-shadow:0 25px 80px rgba(0,0,0,.2)}.modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:14px}.modal-head h2{font-size:23px;margin:4px 0}.proof-image{display:block;max-width:100%;max-height:70vh;margin:auto;border-radius:10px;background:#f5f6f7}.proof-frame{width:100%;height:70vh;border:1px solid #e1e6ea;border-radius:10px}

.login-screen{min-height:100vh;display:grid;place-items:center;padding:24px;background:#f4f6f8}.login-card{width:min(440px,100%);padding:32px;background:#fff;border:1px solid #e1e6ea;border-radius:18px;box-shadow:0 18px 55px rgba(25,35,50,.07)}.login-card h1{font-size:32px;letter-spacing:-.035em;margin:28px 0 7px}.login-card .brand-lockup{display:flex;flex-direction:column}.login-card .brand-lockup strong{font-size:14px;letter-spacing:.09em}.login-card .brand-lockup span{font-size:12px;color:#7a818a;margin-top:3px}

@media(max-width:1200px){.stats-grid{grid-template-columns:repeat(3,1fr)}.products-page-grid{grid-template-columns:400px minmax(0,1fr)}.catalog-grid{grid-template-columns:1fr}.header-inner{gap:16px;padding:0 18px}.main-nav{overflow:auto}.header-actions .user-name{display:none}}
@media(max-width:900px){.admin-main{padding:26px 18px 60px}.products-page-grid,.settings-layout{grid-template-columns:1fr}.settings-actions{grid-column:auto}.size-summary-grid{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}.stats-grid{grid-template-columns:repeat(2,1fr)}.page-title-row{align-items:flex-start;flex-direction:column}.orders-toolbar{align-items:flex-start;flex-direction:column}.compact-search.wide{width:100%}}
@media(max-width:640px){.admin-main{padding:20px 12px 50px}.admin-header{height:auto}.header-inner{padding:12px;flex-wrap:wrap;align-items:flex-start}.main-nav{order:3;width:100%}.header-actions{margin-left:auto}.page-title-row h1{font-size:33px}.stats-grid{grid-template-columns:1fr}.panel-card{padding:18px}.form-grid.two{grid-template-columns:1fr}.catalog-details{grid-template-columns:1fr 1fr}.size-list{grid-template-columns:1fr 1fr}.settings-preview{grid-template-columns:1fr}.pagination{align-items:flex-start;flex-direction:column}}


/* All orders & payment editor popup */
.main-nav{flex-wrap:wrap}
.category-tag{display:inline-block;margin:1px 4px 3px 0;padding:2px 5px;border-radius:5px;background:#eef1f4;color:#505966;font-size:9px;font-weight:800;vertical-align:middle;white-space:nowrap}
.payment-edit-card{width:min(560px,94vw)}
.payment-edit-form{display:grid;gap:14px}
.payment-edit-form label{display:grid;gap:7px;color:#323840;font-size:13px;font-weight:750}
.payment-edit-form input,.payment-edit-form select{width:100%;min-height:42px;border:1px solid #d7dce2;border-radius:9px;padding:10px 12px;background:#fff;color:#16191d}
.payment-edit-form input:disabled{background:#f0f2f4;color:#616872}
.payment-edit-reference{display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center;background:#f7f8fa;border:1px solid #e7eaf0;border-radius:10px;padding:13px}
.payment-edit-reference span{color:#747b85;font-size:12px}
.payment-edit-reference strong{text-align:right;font-size:13px}
.payment-edit-form .step-actions{margin-top:2px}
@media(max-width:760px){.main-nav{justify-content:flex-start}.payment-edit-reference{grid-template-columns:1fr}.payment-edit-reference strong{text-align:left}}



/* Tab khusus pengelolaan jenis apparel */
.apparel-types-page-layout {
  width: 100%;
  max-width: none;
  margin: 0;
}

.apparel-types-panel {
  width: 100%;
  min-width: 0;
  padding: 26px;
}

.apparel-types-panel .panel-head {
  align-items: flex-start;
}

@media (max-width: 900px) {
  .apparel-types-panel {
    padding: 20px;
  }
}

@media (max-width: 640px) {
  .apparel-types-panel {
    padding: 18px;
  }
}
